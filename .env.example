APP_ENV=development
DATABASE_URL=postgresql+psycopg://workbench:workbench@localhost:5432/workbench
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=workbench
S3_SECRET_KEY=workbench-secret
S3_BUCKET=product-assets
S3_REGION=us-east-1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Image generation. Keep `mock` for free local development and CI.
# Set to `openai` and provide OPENAI_API_KEY to enable the paid Image API.
# Set `comfyui` to route GENERATE_* tasks to the independent ComfyUI service.
IMAGE_GENERATION_PROVIDER=mock
IMAGE_GENERATION_TIMEOUT_SECONDS=120
IMAGE_GENERATION_MAX_ATTEMPTS=3
IMAGE_GENERATION_QUALITY=medium
IMAGE_GENERATION_OUTPUT_FORMAT=png
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_IMAGE_MODEL=gpt-image-2
BACKGROUND_REMOVAL_PROVIDER=rembg
IMAGE_UPSCALE_PROVIDER=realesrgan
REMBG_ENABLED=false
REALESRGAN_ENABLED=false
COMFYUI_ENABLED=false
COMFYUI_BASE_URL=
COMFYUI_POLL_INTERVAL_SECONDS=0.5
COMFYUI_WORKFLOW_ROOT=workflows/comfyui
REMBG_SERVICE_URL=
REALESRGAN_SERVICE_URL=
REALESRGAN_EXECUTABLE=realesrgan-ncnn-vulkan
REALESRGAN_MODEL=realesrgan-x4plus
REALESRGAN_TILE=256
IMAGE_PROCESSING_TEMP_DIR=
